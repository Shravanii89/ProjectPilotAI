# ─── Backend Environment Variables (Render) ───

# Server Configuration
PORT=5000
NODE_ENV=production

# CORS — comma-separated allowed origins
CORS_ORIGIN=https://project-pilot-ai-fv39.vercel.app,http://localhost:5173

# PostgreSQL Database Connection String
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# GitHub Personal Access Token
GITHUB_TOKEN=your_github_personal_access_token

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key

# Firebase Admin Credentials
FIREBASE_PROJECT_ID=projectpilotai-b76e3
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@projectpilotai-b76e3.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourPrivateKeyHere\n-----END PRIVATE KEY-----\n"

# Optional API Keys
# SEMANTIC_SCHOLAR_API_KEY=your_key
# PATENTSVIEW_API_KEY=your_key

# Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
